        }
      }
    },
    "Pause Android: it keeps its place and uses no CPU until you open an app." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeda Android: Android tetap di posisinya dan tidak memakai CPU sampai Anda membuka aplikasi."
          }
        }
      }
    },
    "Paused to save energy. Opening an app resumes it." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dijeda untuk menghemat energi. Membuka aplikasi akan melanjutkannya."
