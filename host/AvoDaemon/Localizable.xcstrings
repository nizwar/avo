    "Stop Android" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hentikan Android"
          }
        }
      }
    },
    "Stop Android. Open apps close." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hentikan Android. Aplikasi yang terbuka akan ditutup."
          }
        }
      }
    },
    "Stop Anyway" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tetap Hentikan"
          }
        }
      }
    },
    "Stop it and start it again to go on. Your apps and data are kept." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hentikan lalu jalankan lagi untuk melanjutkan. Aplikasi dan data Anda tetap ada."
          }
        }
      }
    },
    "Stopping Android now interrupts the install. If Google apps were already being copied into Android, Avo finishes or undoes the install the next time Android starts; otherwise, install them again." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghentikan Android sekarang akan menyela instalasi. Jika aplikasi Google sudah mulai disalin ke Android, Avo akan menyelesaikan atau membatalkan instalasi saat Android dijalankan lagi; jika belum, instal ulang aplikasi Google."
          }
        }
      }
    },
    "Stopping Android now interrupts the removal. Avo finishes removing Google apps the next time Android starts." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghentikan Android sekarang akan menyela penghapusan. Avo menyelesaikan penghapusan aplikasi Google saat Android dimulai lagi."
          }
        }
      }
    }
