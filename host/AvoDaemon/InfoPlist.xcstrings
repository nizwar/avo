    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Bluetooth permission prompt (macOS asks when Android first turns its Bluetooth on).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With Bluetooth on in Android, its apps find and use the Bluetooth devices this Mac sees, like watches, sensors and beacons."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat Bluetooth Android menyala, app-nya bisa menemukan dan memakai perangkat Bluetooth yang terlihat oleh Mac ini, seperti jam, sensor, dan beacon."
          }
        }
      }
    },
    "NSLocationUsageDescription" : {
      "comment" : "Location permission prompt (macOS asks once).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android apps ask for GPS; Avo answers with where this Mac is. Turn it off in Avo › Settings › System."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Android meminta GPS; Avo menjawab dengan lokasi Mac ini. Matikan di Avo › Pengaturan › Sistem."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Location permission prompt (macOS asks once).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android apps ask for GPS; Avo answers with where this Mac is. Turn it off in Avo › Settings › System."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Android meminta GPS; Avo menjawab dengan lokasi Mac ini. Matikan di Avo › Pengaturan › Sistem."
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Camera permission prompt (macOS asks when an Android app first uses one of the Mac's cameras).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android apps that use the camera, like video calls and scanners, see this Mac's camera while they use it."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Android yang memakai kamera, seperti panggilan video dan pemindai, melihat kamera Mac ini selama memakainya."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Microphone permission prompt (macOS asks when an Android app first records).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android apps that record, like voice notes and calls, hear this Mac's microphone while they record."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Android yang merekam, seperti pesan suara dan panggilan, mendengar mikrofon Mac ini selama merekam."
          }
        }
      }
    },
    "NSRemovableVolumesUsageDescription" : {
      "comment" : "Removable volume permission prompt (macOS asks when Android's data is on an external drive).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android's data can be kept on an external drive (Settings › Storage › Location). Avo reads and writes it there while Android runs."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data Android dapat disimpan di drive eksternal (Pengaturan › Storage › Lokasi). Avo membaca dan menulisnya di sana selama Android berjalan."
          }
        }
      }
    }
  },
  "version" : "1.0"
