<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- "Share this Mac's location with Android" (CoreLocation under the hardened runtime). -->
	<key>com.apple.security.personal-information.location</key>
	<true/>
	<!-- The engine it runs records from the microphone while Android records;
	     macOS asks on the daemon's behalf. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Settings › Devices › Cameras: the daemon captures from the Mac's
	     camera while Android streams one (CameraFeed). -->
	<key>com.apple.security.device.camera</key>
	<true/>
</dict>
</plist>
