        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edit preset"
          }
        }
      }
    },
    "Emulate this phone’s hardware" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiru perangkat keras ponsel ini"
          }
        }
      }
    },
    "Emulated" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emulasi"
          }
        }
      }
    },
    "Emulated shows a picture drawn for the camera, with no camera needed. One of this Mac’s cameras shows what it sees while an Android app uses it (its light is on only then). macOS asks for permission the first time." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emulasi menampilkan gambar yang digambar untuk kamera itu, tanpa perlu kamera. Kamera Mac ini menampilkan apa yang dilihatnya selama app Android memakainya (lampunya menyala hanya saat itu). macOS meminta izin pertama kali."
          }
        }
      }
    },
    "Erase All Apps and Data" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
