            "value" : "Izinkan Avo di Pengaturan Sistem › Umum › Item Login & Ekstensi agar Android bisa berjalan di latar belakang."
          }
        }
      }
    },
    "Allow Avo in System Settings › General › Login Items & Extensions." : {
