        }
      }
    },
    "Your Mac’s GPU" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPU Mac Anda"
          }
        }
      }
    },
    "Your apps and data from %@ were last used by %@. Choose %@ or newer: an older Android can’t use them. Avo chose a version that can." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikasi dan data Anda dari %1$@ terakhir dipakai oleh %2$@. Pilih %3$@ atau yang lebih baru: Android yang lebih lama tidak bisa memakainya. Avo sudah memilih versi yang bisa."
          }
        }
      }
    },
    "Your apps and data stay." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikasi dan data Anda tetap ada."
