      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orientasi"
          }
        }
      }
    },
    "Parts for other devices are left out: %@." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bagian untuk perangkat lain tidak disertakan: %@."
          }
        }
      }
    },
    "Pause" : {
      "localizations" : {
        "id" : {
