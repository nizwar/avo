            "value" : "Anda boleh menutup ini: Android tetap dijalankan."
          }
        }
      }
    },
    "You can still install a package you downloaded." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda tetap bisa menginstal paket yang Anda unduh sendiri."
