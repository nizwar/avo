          "stringUnit" : {
            "state" : "translated",
            "value" : "MindTheGapps belum punya paket untuk %@. Avo memeriksa lagi setiap kali Anda membuka panel ini; paket yang Anda unduh sendiri juga bisa dipakai."
          }
        }
      }
