    },
    "Android starts with this image. Choose another one first." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android memakai image ini. Pilih image lain terlebih dahulu."
          }
        }
      }
    },
    "Android still lists Google Play: these Google apps were not installed by this Avo, so it has no list of their files. Reset Android to remove them." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
