    },
    "The shared folder is on “%@”, which isn’t connected. Android starts without it." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folder bersama ada di “%@”, yang tidak tersambung. Android berjalan tanpanya."
          }
        }
      }
    },
    "The wheel cannot be held to run: press a key or a button." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roda mouse tidak bisa ditahan untuk lari: tekan sebuah tombol."
          }
