    },
    "Avo can’t find %@." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avo tidak menemukan %@."
          }
        }
      }
    },
    "Avo can’t use the Mac’s camera" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avo tidak bisa memakai kamera Mac"
          }
        }
      }
    },
    "Avo couldn’t reach Google’s Android build servers: %@" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avo tidak bisa menghubungi server build Android Google: %@"
          }
        }
      }
    },
    "Avo does not send this report anywhere. Attach it to your message to Avo’s developers." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
