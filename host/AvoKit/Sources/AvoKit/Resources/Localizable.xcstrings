        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk Jangkar"
          }
        }
      }
    },
    "Anchor Tap: while its key is held, the mouse moves the finger from its point, within a circle (emote wheels, aiming a skill)." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
