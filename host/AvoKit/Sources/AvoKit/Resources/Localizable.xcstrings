    "“%@” acts in every mode." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” aktif di semua mode."
          }
        }
      }
    },
    "“%@” follows %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%1$@” follows %2$@."
