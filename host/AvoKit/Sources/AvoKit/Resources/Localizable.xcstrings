      }
    },
    "The wheel works with Tap, Swipe and Hotkey only." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roda mouse hanya bisa untuk Ketuk, Geser, dan Hotkey."
          }
        }
      }
    },
    "The zip has no %@, so it isn’t an Android image Avo can use." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zip ini tidak berisi %@, jadi bukan image Android yang bisa dipakai Avo."
          }
        }
      }
    },
    "The zip is damaged, or it isn’t an Android image zip." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zip ini rusak, atau bukan zip image Android."
          }
        }
      }
    },
    "There are no Android builds of %@ to download right now." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat ini tidak ada build Android %@ yang bisa diunduh."
          }
        }
      }
    },
    "There is no Android data in this folder." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada data Android di folder ini."
          }
        }
      }
    },
    "There is one eye per layout; this is it." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satu tata letak hanya punya satu mata; ini dia."
          }
        }
      }
    },
    "There isn’t enough free disk space. Android needs %@, and %@ is free." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "There isn’t enough free disk space. Android needs %1$@, and %2$@ is free."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruang disk tidak cukup. Android butuh %@, sedangkan yang tersedia %@."
          }
        }
      }
    },
    "There’s no Android image in this folder. Avo looks for boot.img, init_boot.img, vendor_boot.img, super.img and vbmeta.img." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada image Android di folder ini. Avo mencari boot.img, init_boot.img, vendor_boot.img, super.img, dan vbmeta.img."
          }
        }
      }
    },
    "This Android cannot be shaken." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android ini tidak bisa digoyangkan."
          }
        }
      }
    },
    "This Android data was last used by %@, newer than any Android on this Mac (the newest is %@). Android can’t go back to an older version without erasing its data. Download %@ in Settings › Android first." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data Android ini terakhir dipakai oleh %1$@, lebih baru daripada semua Android di Mac ini (yang terbaru %2$@). Android tidak bisa kembali ke versi lama tanpa menghapus datanya. Unduh %3$@ di Pengaturan › Android terlebih dahulu."
          }
        }
      }
    },
    "This Android data was last used by %@, newer than the Android that starts now. Android can’t go back to an older version without erasing its data. Choose %@ in Settings › Android first." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data Android ini terakhir dipakai oleh %1$@, lebih baru daripada Android yang akan berjalan. Android tidak bisa kembali ke versi lama tanpa menghapus datanya. Pilih %2$@ di Pengaturan › Android terlebih dahulu."
          }
        }
      }
    },
    "This Android data was last used by %@. Download %@ in Settings › Android first." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data Android ini terakhir dipakai oleh %1$@. Unduh %2$@ di Pengaturan › Android terlebih dahulu."
          }
        }
      }
    },
    "This Android has no fingerprint sensor Avo can use." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android ini tidak punya sensor sidik jari yang bisa dipakai Avo."
          }
        }
      }
    },
    "This Android image cannot take Google apps." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Image Android ini tidak bisa dipasangi aplikasi Google."
          }
        }
      }
    },
    "This Android shows no widgets." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android ini tidak menampilkan widget."
          }
        }
      }
    },
    "This Mac can give Android at most %lld GB." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac ini bisa memberi Android paling banyak %lld GB."
          }
        }
      }
    },
    "This Mac’s screen refreshes at %lld Hz, out of step with %lld fps, so motion can judder a little." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Layar Mac ini ber-refresh di %1$lld Hz, tidak seirama dengan %2$lld fps, jadi gerakan bisa sedikit tersendat."
          }
        }
      }
    },
    "This Mac’s screen shows up to %lld Hz. Android runs at %lld fps; the window shows %lld of them. Games respond a little faster; Android uses a bit more power." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Layar Mac ini menampilkan hingga %1$lld Hz. Android berjalan di %2$lld fps; jendela menampilkan %3$lld di antaranya. Game merespons sedikit lebih cepat; Android memakai daya sedikit lebih banyak."
          }
        }
      }
    },
    "This Mac’s screens show up to %lld Hz. Android runs at %lld fps; windows show up to %lld of them. Games respond a little faster; Android uses a bit more power." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Layar-layar Mac ini menampilkan hingga %1$lld Hz. Android berjalan di %2$lld fps; jendela menampilkan hingga %3$lld di antaranya. Game merespons sedikit lebih cepat; Android memakai daya sedikit lebih banyak."
          }
        }
      }
    },
    "This app has no key mapping yet. Press ⇧⌘K to set one up." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikasi ini belum punya pemetaan tombol. Tekan ⇧⌘K untuk membuatnya."
          }
        }
      }
    },
    "This app needs Android API %lld; the Android image provides API %lld." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This app needs Android API %1$lld; the Android image provides API %2$lld."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikasi ini butuh Android API %lld; image Android menyediakan API %lld."
          }
        }
      }
    },
    "This app only contains %@ code. Avo runs 64-bit ARM Android, so the app cannot start." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikasi ini hanya berisi kode %@. Avo menjalankan Android ARM 64-bit, jadi aplikasi ini tidak bisa berjalan."
          }
        }
      }
    },
    "This control has no key yet. Press its key or controller button, or right-click for a mouse button." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrol ini belum punya tombol. Tekan tombolnya di keyboard atau controller, atau klik kanan untuk tombol mouse."
          }
        }
      }
    },
    "This controller cannot vibrate" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontroler ini tidak bisa bergetar"
          }
        }
      }
    },
    "This engine cannot hold Android still. Stop Android first." : {
      "localizations" : {
        "id" : {
