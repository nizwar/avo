          "stringUnit" : {
            "state" : "translated",
            "value" : "Avo sedang menyalin data Android di disk ini. Keluarkan setelah penyalinan selesai."
          }
        }
      }
    },
    "Avo keeps up to %lld fingers. Remove one first." : {
      "localizations" : {
        "id" : {
