        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android berhenti merespons"
          }
        }
      }
    },
    "Android stopped so “%@” can be ejected. Eject it again." : {
      "localizations" : {
        "id" : {
