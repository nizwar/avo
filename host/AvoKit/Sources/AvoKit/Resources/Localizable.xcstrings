      }
    },
    "It’s %@, and Avo needs Android 16 or newer." : {
      "extractionState" : "stale",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini %@, sedangkan Avo memerlukan Android 16 atau yang lebih baru."
          }
        }
      }
    },
    "It’s a %@ build. Avo needs a userdebug build, which lets it set Android up as root." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini build %@. Avo memerlukan build userdebug, yang memungkinkannya menyiapkan Android sebagai root."
