    },
    "Avo doesn’t know Android %@." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avo tidak mengenal Android %@."
          }
        }
      }
    },
    "Avo is already changing Google apps." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avo sedang mengubah aplikasi Google."
          }
        }
      }
    },
    "Avo is already changing where Android’s data is." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avo sudah sedang memindahkan tempat data Android."
          }
