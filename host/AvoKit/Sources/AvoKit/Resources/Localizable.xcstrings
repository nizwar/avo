    },
    "Android was stopped." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android dihentikan."
          }
        }
      }
    },
    "Android’s Settings adds the finger that touches the sensor. Choose one of your fingers." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelan Android menambahkan jari yang menyentuh sensor. Pilih salah satu jari Anda."
