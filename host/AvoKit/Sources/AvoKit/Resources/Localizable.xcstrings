      }
    },
    "Eject “%@” only while Android is stopped. If you eject it while Android runs, Avo stops Android first and asks you to eject again." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keluarkan “%@” hanya saat Android berhenti. Jika Anda mengeluarkannya saat Android berjalan, Avo menghentikan Android terlebih dahulu dan meminta Anda mengeluarkannya lagi."
          }
        }
      }
    },
