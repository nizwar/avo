    },
    "Avo is asking to use the camera" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avo meminta izin memakai kamera"
          }
        }
      }
    },
    "Avo is changing Google apps and restarts Android by itself meanwhile. Wait until it finishes." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avo sedang mengubah aplikasi Google, dan selama itu Avo memulai ulang Android sendiri. Tunggu sampai selesai."
          }
        }
      }
    },
    "Avo is changing where Android’s data is. Android starts when that is done." : {
      "localizations" : {
