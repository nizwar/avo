            "value" : "Bergerak ke arah kursor"
          }
        }
      }
    },
    "Moving Android’s data needs %@ on “%@”, which has %@ free." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memindahkan data Android butuh %1$@ di “%2$@”, yang hanya punya %3$@ ruang kosong."
          }
        }
      }
    },
    "Moving stopped. Android’s data stays where it was." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemindahan dihentikan. Data Android tetap di tempatnya."
          }
        }
      }
    },
    "My controller layout" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tata letak kontroler saya"
          }
        }
