{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ (build %@)" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (build %2$@)"
          }
        }
      }
    },
    "%@ does not exist." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tidak ada."
          }
        }
      }
    },
    "%@ does not match the release’s SHA-256 checksum. Try downloading it again." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tidak cocok dengan checksum SHA-256 rilisnya. Coba unduh lagi."
          }
        }
      }
    },
    "%@ doesn’t look like part of an Android image." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tidak tampak seperti bagian dari image Android."
          }
        }
      }
    },
    "%@ failed its checksum." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checksum %@ tidak cocok."
          }
        }
      }
    },
    "%@ has the wrong size." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukuran %@ salah."
          }
        }
      }
    },
    "%@ holds Avo’s own files or Android’s data. Choose another folder to share." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ berisi file Avo sendiri atau data Android. Pilih folder lain untuk dibagikan."
          }
        }
      }
    },
    "%@ holds other Android data than the data Avo used there. Choose it again in Settings › Storage to use it." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ berisi data Android lain, bukan data yang dipakai Avo di sana. Pilih lagi di Pengaturan › Storage untuk memakainya."
          }
        }
      }
    },
    "%@ is in the way." : {
      "extractionState" : "stale",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ menghalangi."
          }
        }
      }
    },
    "%@ is missing" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tidak ditemukan"
          }
        }
      }
    },
    "%@ is not a GitHub release link." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bukan tautan rilis GitHub."
          }
        }
      }
    },
    "%@ is not a folder." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bukan folder."
          }
        }
      }
    },
    "%@ is not installed." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tidak terinstal."
          }
        }
      }
    },
    "%@ is part of Android’s system apps and cannot be uninstalled. Reset Android removes Google apps." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ termasuk aplikasi sistem Android dan tidak bisa diuninstal. Reset Android menghapus aplikasi Google."
          }
        }
      }
    },
    "%@ is unexpectedly large (%@)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is unexpectedly large (%2$@)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ terlalu besar (%@)."
          }
        }
      }
    },
    "%@ timed out." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ melewati batas waktu."
          }
        }
      }
    },
    "A %lld GB disk takes its full size on “%@”, which has %@ free." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disk %1$lld GB langsung memakai seluruh ukurannya di “%2$@”, yang hanya punya %3$@ ruang kosong."
          }
        }
      }
    },
    "A finger named “%@” is already registered." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jari bernama “%@” sudah terdaftar."
          }
        }
      }
    },
    "A finger’s name can’t contain line breaks or other control characters." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nama jari tidak boleh berisi baris baru atau karakter kontrol lain."
          }
        }
      }
    },
    "Allow Avo in System Settings › Privacy & Security › Camera, or choose another camera in Avo › Settings › Devices." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izinkan Avo di Pengaturan Sistem › Privasi & Keamanan › Kamera, atau pilih kamera lain di Avo › Pengaturan › Perangkat."
          }
        }
      }
    },
    "Android already has “%@”. Choose another finger to add." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android sudah punya “%@”. Pilih jari lain untuk ditambahkan."
          }
        }
      }
    },
    "Android could not check the screen lock." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android tidak dapat memeriksa kunci layar."
          }
        }
      }
    },
    "Android could not start: %@" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android tidak bisa dimulai: %@"
          }
        }
      }
    },
    "Android did not list its apps" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android tidak bisa mencantumkan aplikasinya"
          }
        }
      }
    },
    "Android did not list its fingerprints." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android tidak memberikan daftar sidik jarinya."
          }
        }
      }
    },
    "Android did not respond." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android tidak merespons."
          }
        }
      }
    },
    "Android did not say its volume." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android tidak memberi tahu volumenya."
          }
        }
      }
    },
    "Android did not take the change: %@" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android tidak menerima perubahan ini: %@"
          }
        }
      }
    },
    "Android did not uninstall %@" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android gagal menguninstal %@"
          }
        }
      }
    },
    "Android does not support this: %@" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android tidak mendukung ini: %@"
          }
        }
      }
    },
    "Android has no apps or data yet, so there is nothing to keep." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android belum punya aplikasi atau data, jadi belum ada yang bisa disimpan."
          }
        }
      }
    },
    "Android is already being changed; the install can no longer stop." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android sedang diubah; instalasi tidak bisa dihentikan lagi."
          }
        }
      }
    },
    "Android is already being unlocked." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunci Android sedang dibuka."
          }
        }
      }
    },
    "Android is locked by its screen lock. Unlock it in Avo to open your apps." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android terkunci oleh kunci layarnya. Buka kuncinya di Avo untuk membuka aplikasi Anda."
          }
        }
      }
    },
    "Android is not running." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android tidak berjalan."
          }
        }
      }
    },
    "Android is out of storage; uninstall apps or clear their data to make room, or use Change Size in Settings › Storage, which erases Android’s data" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "penyimpanan Android penuh; uninstal aplikasi atau hapus datanya untuk memberi ruang, atau gunakan Ubah Ukuran di Pengaturan › Storage, yang menghapus data Android"
          }
        }
      }
    },
    "Android is restarting" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android sedang dimulai ulang"
          }
        }
      }
    },
    "Android is running. Stop Android to change where its data is." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android sedang berjalan. Hentikan Android untuk mengubah tempat datanya."
          }
        }
      }
    },
    "Android is starting or stopping. Try again in a moment." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android sedang dimulai atau dihentikan. Coba lagi sebentar lagi."
          }
        }
      }
    },
    "Android is waiting because the Mac’s disk is full. Free some space, and Android goes on." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android menunggu karena disk Mac penuh. Kosongkan sebagian ruang, lalu Android berjalan lagi."
          }
        }
      }
    },
    "Android is waiting because “%@” is full. Free some space on it, and Android goes on." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android menunggu karena “%@” penuh. Kosongkan sebagian ruang di sana, lalu Android berjalan lagi."
          }
        }
      }
    },
    "Android keeps its storage on this disk. Avo is stopping Android; eject the disk again in a moment." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android menyimpan penyimpanannya di disk ini. Avo sedang menghentikan Android; keluarkan disk lagi sebentar lagi."
          }
        }
      }
    },
    "Android keeps restarting, so Avo stopped it. Start Android to try again." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android terus memulai ulang, jadi Avo menghentikannya. Jalankan Android untuk mencoba lagi."
          }
        }
      }
    },
    "Android needs %@ free in %@ but has %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Android needs %1$@ free in %2$@ but has %3$@."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android butuh ruang kosong %@ di %@, tetapi hanya ada %@."
          }
        }
      }
    },
    "Android no longer has this widget." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android tidak lagi punya widget ini."
          }
        }
      }
    },
    "Android reported an error." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android melaporkan kesalahan."
          }
        }
      }
    },
    "Android restarted while it started with Magisk, so Avo started it again without root. Your apps and data are as they were." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android memulai ulang saat dinyalakan dengan Magisk, jadi Avo menyalakannya lagi tanpa root. Aplikasi dan data Anda tetap seperti semula."
          }
        }
      }
    },
    "Android restarts to make its system partitions writable." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android dimulai ulang agar partisi sistemnya bisa ditulisi."
          }
        }
      }
    },
    "Android restarts with Google apps." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android dimulai ulang dengan aplikasi Google."
          }
        }
      }
    },
    "Android restarts with verified boot off." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android dimulai ulang dengan verified boot nonaktif."
          }
        }
      }
    },
    "Android restarts without Google apps." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android dimulai ulang tanpa aplikasi Google."
          }
        }
      }
    },
    "Android showed nothing on the GPU within a minute." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android tidak menampilkan apa pun dengan GPU dalam satu menit."
          }
        }
      }
    },
    "Android starts with this image. Choose another one first." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android memakai image ini. Pilih image lain terlebih dahulu."
          }
        }
      }
    },
    "Android still lists Google Play: these Google apps were not installed by this Avo, so it has no list of their files. Reset Android to remove them." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android masih mencantumkan Google Play: aplikasi Google ini tidak diinstal oleh Avo ini, jadi Avo tidak punya daftar file-nya. Reset Android untuk menghapusnya."
          }
        }
      }
    },
    "Android stopped responding" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android berhenti merespons"
          }
        }
      }
    },
    "Android stopped so “%@” can be ejected. Eject it again." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android dihentikan agar “%@” bisa dikeluarkan. Keluarkan lagi."
          }
        }
      }
    },
    "Android stopped twice within 10 minutes while using the GPU." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android berhenti dua kali dalam 10 menit saat memakai GPU."
          }
        }
      }
    },
    "Android stopped while starting on the GPU." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android berhenti saat dimulai dengan GPU."
          }
        }
      }
    },
    "Android took the screen lock, but its lock screen stayed up. Try again." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android menerima kunci layar, tetapi layar kuncinya tetap tampil. Coba lagi."
          }
        }
      }
    },
    "Android was reset, but Avo couldn’t remove %@ beside its data." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reset Android selesai, tetapi Avo tidak bisa menghapus %@ di samping datanya."
          }
        }
      }
    },
    "Android was stopped while Google apps were being installed. Avo finishes or undoes the install the next time Android starts." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android dihentikan saat aplikasi Google sedang diinstal. Avo menyelesaikan atau membatalkan instalasinya saat Android dijalankan berikutnya."
          }
        }
      }
    },
    "Android was stopped while Google apps were being removed. Avo finishes removing them the next time Android starts." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android dihentikan saat aplikasi Google sedang dihapus. Avo menyelesaikan penghapusannya saat Android dimulai lagi."
          }
        }
      }
    },
    "Android was stopped." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android dihentikan."
          }
        }
      }
    },
    "Android’s Settings adds the finger that touches the sensor. Choose one of your fingers." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelan Android menambahkan jari yang menyentuh sensor. Pilih salah satu jari Anda."
          }
        }
      }
    },
    "Android’s answer" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jawaban Android"
          }
        }
      }
    },
    "Android’s checkpoints can’t come along to “%@”. Keep the old copy to keep them." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checkpoint Android tidak bisa ikut ke “%@”. Simpan salinan lama untuk menyimpannya."
          }
        }
      }
    },
    "Android’s data can’t be in a folder that syncs to the cloud (iCloud Drive, Dropbox, Google Drive …): it changes all the time while Android runs. Choose a folder on this Mac or a drive." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data Android tidak bisa berada di folder yang disinkronkan ke cloud (iCloud Drive, Dropbox, Google Drive …): datanya terus berubah selama Android berjalan. Pilih folder di Mac ini atau di sebuah drive."
          }
        }
      }
    },
    "Android’s data can’t be on a network volume. Choose a drive connected to this Mac." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data Android tidak bisa berada di volume jaringan. Pilih drive yang tersambung ke Mac ini."
          }
        }
      }
    },
    "Android’s data is not available." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data Android tidak tersedia."
          }
        }
      }
    },
    "Android’s data is there already." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data Android sudah ada di sana."
          }
        }
      }
    },
    "Android’s storage can grow to %@; “%@” has %@ free. Android runs out of space when the drive is full." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penyimpanan Android bisa tumbuh hingga %1$@; “%2$@” punya %3$@ ruang kosong. Android kehabisan ruang jika drive penuh."
          }
        }
      }
    },
    "Android’s storage can grow to %lld GB; “%@” has %@ free. Android runs out of space when the drive is full." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penyimpanan Android bisa tumbuh hingga %1$lld GB; “%2$@” punya %3$@ ruang kosong. Android kehabisan ruang jika drive penuh."
          }
        }
      }
    },
    "Android’s storage folder is missing: %@. Choose where Android’s data should be." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folder penyimpanan Android tidak ada: %@. Pilih tempat data Android."
          }
        }
      }
    },
    "Android’s storage is already created (%@). Its size changes only when Android’s data is erased: use Change Size… in Settings › Storage." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penyimpanan Android sudah dibuat (%@). Ukurannya hanya bisa berubah bila data Android dihapus: gunakan Ubah Ukuran… di Pengaturan › Storage."
          }
        }
      }
    },
    "Android’s storage is on “%@”, which isn’t connected. Connect it, or choose where Android’s data should be." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penyimpanan Android ada di “%@”, yang tidak tersambung. Sambungkan, atau pilih tempat data Android."
          }
        }
      }
    },
    "Android’s storage must be between %lld and %lld GB." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penyimpanan Android harus antara %1$lld dan %2$lld GB."
          }
        }
      }
    },
    "Android’s system partitions stayed read-only" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partisi sistem Android tetap hanya-baca"
          }
        }
      }
    },
    "Answer macOS’s question to see the Mac’s camera here." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jawab pertanyaan macOS untuk melihat kamera Mac di sini."
          }
        }
      }
    },
    "Avo cannot set this Android’s volume." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
