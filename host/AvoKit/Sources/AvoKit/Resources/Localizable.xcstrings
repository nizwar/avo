{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ (build %@)" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (build %2$@)"
          }
        }
      }
    },
    "%@ Copy" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salinan %@"
          }
        }
      }
    },
    "%@ cannot drive that." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tidak bisa menggerakkan itu."
          }
        }
      }
    },
    "%@ does not exist." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tidak ada."
          }
        }
      }
    },
    "%@ does not match the release’s SHA-256 checksum. Try downloading it again." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tidak cocok dengan checksum SHA-256 rilisnya. Coba unduh lagi."
          }
        }
      }
    },
    "%@ doesn’t look like part of an Android image." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tidak tampak seperti bagian dari image Android."
          }
        }
      }
    },
    "%@ failed its checksum." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checksum %@ tidak cocok."
          }
        }
      }
    },
    "%@ has the wrong size." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukuran %@ salah."
          }
        }
      }
    },
    "%@ holds Avo’s own files or Android’s data. Choose another folder to share." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ berisi file Avo sendiri atau data Android. Pilih folder lain untuk dibagikan."
          }
        }
      }
    },
    "%@ holds other Android data than the data Avo used there. Choose it again in Settings › Storage to use it." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ berisi data Android lain, bukan data yang dipakai Avo di sana. Pilih lagi di Pengaturan › Storage untuk memakainya."
          }
        }
      }
    },
    "%@ is a direction of this joystick: press another key to run." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ adalah arah joystick ini: tekan tombol lain untuk lari."
          }
        }
      }
    },
    "%@ is a direction of “%@”." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is a direction of “%2$@”."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ adalah salah satu arah “%2$@”."
          }
        }
      }
    },
    "%@ is in the way." : {
      "extractionState" : "stale",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ menghalangi."
          }
        }
      }
    },
    "%@ is missing" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tidak ditemukan"
          }
        }
      }
    },
    "%@ is not a GitHub release link." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bukan tautan rilis GitHub."
          }
        }
      }
    },
    "%@ is not a folder." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bukan folder."
          }
        }
      }
    },
    "%@ is not installed." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tidak terinstal."
          }
        }
      }
    },
    "%@ is part of Android’s system apps and cannot be uninstalled. Reset Android removes Google apps." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ termasuk aplikasi sistem Android dan tidak bisa diuninstal. Reset Android menghapus aplikasi Google."
          }
        }
      }
    },
    "%@ is unexpectedly large (%@)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is unexpectedly large (%2$@)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ terlalu besar (%@)."
          }
        }
      }
    },
    "%@ locks the mouse to aim with the eye, and frees it again." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ mengunci mouse untuk membidik dengan mata, dan melepasnya lagi."
          }
        }
      }
    },
    "%@ runs" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ lari"
          }
        }
      }
    },
    "%@ timed out." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ melewati batas waktu."
          }
        }
      }
    },
    "%@ turns the eye now. Drag its area over the part of the game that turns the camera." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekarang %@ memutar mata. Seret areanya ke bagian game yang memutar kamera."
          }
        }
      }
    },
    "%@: %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: %2$@"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: %2$@"
          }
        }
      }
    },
    "%@: a joystick or the eye cannot do actions" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: joystick atau mata tidak bisa menjalankan aksi"
          }
        }
      }
    },
    "%@: aim area is invalid" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: area bidik tidak valid"
          }
        }
      }
    },
    "%@: anchor reach must be between 0.03 and 1" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: jangkauan jangkar harus antara 0,03 dan 1"
          }
        }
      }
    },
    "%@: click area is invalid" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: area klik tidak valid"
          }
        }
      }
    },
    "%@: curve exponent must be between 0.5 and 3" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: eksponen kurva harus antara 0,5 dan 3"
          }
        }
      }
    },
    "%@: deadzone must be between 0 and 50" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: deadzone harus antara 0 dan 50"
          }
        }
      }
    },
    "%@: does nothing yet: add an action" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: belum melakukan apa pun: tambahkan aksi"
          }
        }
      }
    },
    "%@: drag it onto the game" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: seret ke game"
          }
        }
      }
    },
    "%@: holds must last at least %lld ms" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: holds must last at least %2$lld ms"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: tahan minimal %lld ms"
          }
        }
      }
    },
    "%@: locking or freeing the mouse needs the eye (mouse look)" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: mengunci atau melepaskan mouse butuh mata (lihat dengan mouse)"
          }
        }
      }
    },
    "%@: macros are not allowed in FPS mode (no recoil or fire macros)" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: makro tidak diizinkan di mode FPS (tanpa makro recoil atau tembak)"
          }
        }
      }
    },
    "%@: macros may run at most 10 s" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: makro paling lama 10 detik"
          }
        }
      }
    },
    "%@: macros need 1–32 steps" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: makro butuh 1–32 langkah"
          }
        }
      }
    },
    "%@: needs a trigger" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: butuh pemicu"
          }
        }
      }
    },
    "%@: no mode %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: no mode %2$@"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: tidak ada mode %2$@"
          }
        }
      }
    },
    "%@: no mode %@ to switch to" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: no mode %2$@ to switch to"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: tidak ada mode %2$@ untuk dituju"
          }
        }
      }
    },
    "%@: position %@, %@ is outside the screen" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: position %2$@, %3$@ is outside the screen"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: posisi %@, %@ berada di luar layar"
          }
        }
      }
    },
    "%@: radius must be between 0.01 and 0.5" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: radius harus antara 0,01 dan 0,5"
          }
        }
      }
    },
    "%@: reach must be between 0.05 and 2" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: jangkauan harus antara 0,05 dan 2"
          }
        }
      }
    },
    "%@: repeat interval must be at least 50 ms" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: interval ulang minimal 50 ms"
          }
        }
      }
    },
    "%@: repeated taps are not allowed in FPS mode (no automatic rapid fire)" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: ketukan berulang tidak diizinkan di mode FPS (tanpa rapid fire otomatis)"
          }
        }
      }
    },
    "%@: running reach must be 1 to 4 times the joystick's" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: jangkauan lari harus 1 sampai 4 kali jangkauan joystick"
          }
        }
      }
    },
    "%@: scroll triggers only work with tap, swipe, macro and hotkey controls" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: pemicu gulir hanya bisa untuk kontrol ketuk, geser, makro, dan hotkey"
          }
        }
      }
    },
    "%@: select a control on the game first, or drag %@ onto the game." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: select a control on the game first, or drag %2$@ onto the game."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: pilih dulu kontrol di game, atau seret %2$@ ke game."
          }
        }
      }
    },
    "%@: sensitivity must be between 0.01 and 20" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: sensitivitas harus antara 0,01 dan 20"
          }
        }
      }
    },
    "%@: size must be between %lf and %lf" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: size must be between %2$lf and %3$lf"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: ukuran harus antara %2$lf dan %3$lf"
          }
        }
      }
    },
    "%@: swipe duration must be 30–2000 ms" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: durasi geser harus 30–2000 ms"
          }
        }
      }
    },
    "%@: swipes may not touch the aim area (no recoil compensation)" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: geser tidak boleh menyentuh area bidik (tanpa kompensasi recoil)"
          }
        }
      }
    },
    "%@: the key to run is also a direction" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: tombol lari juga dipakai sebagai arah"
          }
        }
      }
    },
    "%@: the wheel cannot be held to run" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: roda mouse tidak bisa ditahan untuk lari"
          }
        }
      }
    },
    "%@: touch-down point must be inside the aim area" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: titik sentuh harus berada di dalam area bidik"
          }
        }
      }
    },
    "%@: waits must be at least %lld ms" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: waits must be at least %2$lld ms"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: jeda minimal %lld ms"
          }
        }
      }
    },
    "%lld controls that act only there or switch to it go too. Cancel in the editor still undoes it." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld kontrol yang hanya aktif di sana atau beralih ke sana ikut terhapus. Batal di editor masih bisa mengurungkannya."
          }
        }
      }
    },
    "%lld ms" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld ms"
          }
        }
      }
    },
    "%lld%% × %lld%% of the screen" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld%% × %2$lld%% of the screen"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld%% × %2$lld%% layar"
          }
        }
      }
    },
    "A %lld GB disk takes its full size on “%@”, which has %@ free." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disk %1$lld GB langsung memakai seluruh ukurannya di “%2$@”, yang hanya punya %3$@ ruang kosong."
          }
        }
      }
    },
    "A click area needs no key: it acts when it is clicked while the mouse is free." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Area klik tidak perlu tombol: ia bekerja saat diklik ketika mouse bebas."
          }
        }
      }
    },
    "A copy of “%@”, with its controls: type its name in its tab." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salinan “%@” beserta kontrolnya: ketik namanya di tabnya."
          }
        }
      }
    },
    "A finger named “%@” is already registered." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jari bernama “%@” sudah terdaftar."
          }
        }
      }
    },
    "A finger’s name can’t contain line breaks or other control characters." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nama jari tidak boleh berisi baris baru atau karakter kontrol lain."
          }
        }
      }
    },
    "A joystick follows a stick or the d-pad." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joystick mengikuti stik atau d-pad."
          }
        }
      }
    },
    "A light pulse when a button touches the screen" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Getaran ringan saat tombol menyentuh layar"
          }
        }
      }
    },
    "A mode is another set of controls for another situation in the game (on foot, in a vehicle, an inventory). A control’s Switch Mode action changes to it." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mode adalah kumpulan kontrol lain untuk situasi lain di game (jalan kaki, di kendaraan, inventaris). Aksi Ganti Mode pada sebuah kontrol berpindah ke sana."
          }
        }
      }
    },
    "A new mode, and the switch to it: name the mode in its tab, then add its controls." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mode baru, beserta perpindahan ke sana: beri nama mode di tabnya, lalu tambahkan kontrolnya."
          }
        }
      }
    },
    "A new mode, empty: add its controls." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mode baru, masih kosong: tambahkan kontrolnya."
          }
        }
      }
    },
    "A stick drives a joystick or the eye. To use pressing it down (%@) here, press the stick down." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stik menggerakkan joystick atau mata. Untuk memakai tekanan stik (%@) di sini, tekan stiknya ke bawah."
          }
        }
      }
    },
    "A stick drives a joystick or the eye; drop it on the game to place one." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stik menggerakkan joystick atau mata; lepaskan di game untuk menaruhnya."
          }
        }
      }
    },
    "A tap on %@, together with %@. Click the next button of the game and press its key." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A tap on %1$@, together with %2$@. Click the next button of the game and press its key."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk dengan %1$@, bersama %2$@. Klik tombol game berikutnya, lalu tekan tombolnya."
          }
        }
      }
    },
    "A tap on %@. Click the next button of the game and press its key." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk dengan %@. Klik tombol game berikutnya, lalu tekan tombolnya."
          }
        }
      }
    },
    "Above 1×, a smaller push reaches the joystick’s edge, and the eye turns faster." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di atas 1×, dorongan yang lebih kecil sudah mencapai tepi joystick, dan mata berputar lebih cepat."
          }
        }
      }
    },
    "Add Action" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambah Aksi"
          }
        }
      }
    },
    "Add Mode" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambah Mode"
          }
        }
      }
    },
    "Add a Control" : {
      "localizations" : {
        "id" : {
