// Settings shared by every Avo target.
//
// The bundle identifier prefix: Avo's domain, avodroid.com. Builds before
// 0.3.0 Preview 2 used dev.avo (AvoIdentifiers.formerPrefix; Avo moves what
// was kept under it). Keep it in sync with AvoIdentifiers.prefix (AvoKit);
// VMConfigTests checks that they match.
AVO_BUNDLE_ID_PREFIX = com.avodroid
// Avo.app's own identifier (AvoIdentifiers.app); its helpers use the prefix.
AVO_APP_BUNDLE_ID = com.avodroid.emulator

// Marketing version of the macOS app; the Android image is versioned separately.
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

MACOSX_DEPLOYMENT_TARGET = 15.0

// Localization: English source text, Indonesian translations in String
// Catalogs (Localizable.xcstrings per target, AvoKit/Sources/AvoKit/Resources
// for the package). The compiler records every localizable string it sees
// (.stringsdata) so scripts/sync-strings.sh can update the catalogs.
SWIFT_EMIT_LOC_STRINGS = YES
LOCALIZATION_PREFERS_STRING_CATALOGS = YES
ARCHS = arm64
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
ENABLE_HARDENED_RUNTIME = YES
DEAD_CODE_STRIPPING = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES

// Set AVO_TEAM_ID (or DEVELOPMENT_TEAM) in Local.xcconfig for Developer ID builds.
// Without it the targets are signed to run locally (ad hoc).
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM = $(AVO_TEAM_ID)
// Release builds without get-task-allow (a debugger may attach): the notary
// service refuses it, and a released Avo has no use for it.
CODE_SIGN_INJECT_BASE_ENTITLEMENTS[config=Release] = NO

#include? "Local.xcconfig"
