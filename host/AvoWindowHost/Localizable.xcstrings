      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gaya app bar"
          }
        }
      }
    },
    "Apple Maps couldn’t find that place." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Maps tidak menemukan tempat itu."
          }
        }
      }
    },
    "Apple Maps found no road there, so this part is a straight line." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Maps tidak menemukan jalan di sana, jadi bagian ini berupa garis lurus."
