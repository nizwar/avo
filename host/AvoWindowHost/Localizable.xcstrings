      }
    },
    "The text on screen is already in %@." : {
      "extractionState" : "stale",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teks di layar sudah dalam bahasa %@."
          }
        }
      }
    },
    "The text on screen is already in %@. To translate it into another language, choose one under Translate Into." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teks di layar sudah dalam bahasa %@. Untuk menerjemahkannya ke bahasa lain, pilih salah satu di Terjemahkan ke."
          }
        }
      }
    },
    "The wheel works with Tap and Swipe only." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roda mouse hanya bisa untuk Ketuk dan Geser."
