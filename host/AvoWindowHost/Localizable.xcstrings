      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac Ini"
          }
        }
      }
    },
    "This Mac’s location" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokasi Mac ini"
          }
        }
      }
    },
    "This app" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikasi ini"
          }
        }
      }
    },
    "This app follows every app’s location." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App ini mengikuti lokasi semua app."
          }
        }
      }
    },
    "This app gets its own location, starting where every app is. Android reports it while this window is in front." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App ini punya lokasi sendiri, dimulai dari lokasi semua app. Android melaporkannya selama jendela ini di depan."
          }
        }
      }
    },
    "This app has a key mapping: ⌘G turns on Game Mode." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App ini punya pemetaan tombol: ⌘G menyalakan Mode Game."
          }
        }
      }
    },
    "This controller cannot vibrate" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontroler ini tidak bisa bergetar"
          }
        }
      }
    },
    "This layout already has controls. Add the template's controls next to them (keys you already use stay with your controls), or replace the layout with the template. Its positions are only a starting point, and Cancel in the editor still undoes everything." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tata letak ini sudah berisi kontrol. Tambahkan kontrol templat di sampingnya (tombol yang sudah Anda pakai tetap pada kontrol Anda), atau ganti tata letak dengan templat. Posisinya hanya titik awal, dan Batal di editor tetap membatalkan semuanya."
          }
        }
      }
    },
    "This layout has controls from a newer version of Avo (%@). They are not shown here, and saving leaves them out." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tata letak ini berisi kontrol dari versi Avo yang lebih baru (%@). Kontrol itu tidak ditampilkan di sini dan tidak ikut disimpan."
          }
        }
      }
    },
    "This profile has problems." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil ini bermasalah."
          }
        }
      }
    },
