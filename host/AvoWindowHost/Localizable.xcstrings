      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jendela ini"
          }
        }
      }
    },
    "Too many tries. Enter Android’s screen lock to use fingerprints again." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terlalu banyak percobaan. Masukkan kunci layar Android agar sidik jari bisa dipakai lagi."
          }
        }
      }
    },
    "Too many tries. Try again in about 30 seconds." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terlalu banyak percobaan. Coba lagi sekitar 30 detik lagi."
