          }
        }
      }
    },
    "The controller is laid out as in %@ games: %lld controls. Cancel undoes it." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The controller is laid out as in %1$@ games: %2$lld controls. Cancel undoes it."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontroler ditata seperti di game %1$@: %2$lld kontrol. Batal akan mengurungkannya."
          }
        }
      }
    },
    "The controller mapping is reset." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemetaan kontroler sudah diatur ulang."
          }
        }
