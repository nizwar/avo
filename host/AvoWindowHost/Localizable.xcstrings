    },
    "Apple Maps’ directions between stops" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Petunjuk arah Apple Maps antartitik singgah"
          }
        }
      }
    },
    "Apple’s MetalFX keeps edges and text sharp when the picture is enlarged." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MetalFX buatan Apple menjaga tepi dan teks tetap tajam saat gambar diperbesar."
          }
        }
      }
    },
    "Apps" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikasi"
          }
        }
      }
    },
    "Apps: Android takes the window’s size, sharp for reading. Games: a fixed 720p landscape screen that runs faster. Phone: the phone’s own screen, at its density. What you change below is kept on top." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikasi: Android mengikuti ukuran jendela, tajam untuk membaca. Game: layar 720p lanskap yang tetap, lebih cepat. Ponsel: layar ponsel itu sendiri, dengan DPI-nya. Yang Anda ubah di bawah tetap berlaku di atasnya."
          }
        }
      }
    },
    "Apps: Android takes the window’s size, sharp for reading. Games: a fixed 720p landscape screen that runs faster. What you change below is kept on top." : {
      "extractionState" : "stale",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikasi: Android mengikuti ukuran jendela, tajam untuk membaca. Game: layar 720p lanskap yang tetap, lebih cepat. Yang Anda ubah di bawah tetap berlaku di atasnya."
          }
        }
      }
    },
