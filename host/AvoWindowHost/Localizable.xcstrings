      }
    },
    "The screen turned, so the recording stopped. It is saved in %@." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Layar berputar, jadi perekaman berhenti. Rekaman disimpan di %@."
          }
