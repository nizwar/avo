    },
    "The recording stopped early and is saved in %@ up to that point. %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The recording stopped early and is saved in %1$@ up to that point. %2$@"
