    "Android added “%@”." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android menambahkan “%@”."
          }
        }
      }
    },
    "Android app %@, running in Avo." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikasi Android %@, berjalan di Avo."
          }
        }
      }
    },
    "Android did not recognize that finger." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android tidak mengenali jari itu."
          }
        }
      }
    },
    "Android gets the phone’s screen, so apps lay out as on the phone." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android mendapat layar ponsel, jadi tata letak aplikasi seperti di ponsel itu."
          }
        }
      }
    },
    "Android has this finger already." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android sudah punya jari ini."
          }
        }
      }
    },
    "Android is locked" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android terkunci"
          }
        }
      }
    },
    "Android is not running" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android tidak berjalan"
          }
        }
      }
    },
    "Android isn’t running. The route goes on when it does." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android tidak berjalan. Rute berlanjut saat Android berjalan."
          }
        }
      }
    },
    "Android keeps one resolution, scaled to the window." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android memakai satu resolusi tetap, diskalakan ke jendela."
          }
        }
      }
    },
    "Android needs a screen lock for fingerprints" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android perlu kunci layar untuk sidik jari"
          }
        }
      }
    },
    "Android plays under your Mac’s volume: at 100%, the Mac’s volume alone sets how loud it is." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android diputar di bawah volume Mac Anda: di 100%, volume Mac saja yang mengatur seberapa keras suaranya."
          }
        }
      }
    },
    "Android recognized “%@”." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android mengenali “%@”."
          }
        }
