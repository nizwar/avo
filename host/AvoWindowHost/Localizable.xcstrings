{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ %@ at %@" : {
      "comment" : "Screenshot and screen recording file name: app name, date, time",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@ at %3$@"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ pukul %3$@"
          }
        }
      }
    },
    "%@ (Default)" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (Default)"
          }
        }
      }
    },
    "%@ Copy" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salinan %@"
          }
        }
      }
    },
    "%@ cannot drive that." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tidak bisa menggerakkan itu."
          }
        }
      }
    },
    "%@ closed." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tertutup."
          }
        }
      }
    },
    "%@ dp" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dp"
          }
        }
      }
    },
    "%@ heading %lld°" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ heading %2$lld°"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ke arah %2$lld°"
          }
        }
      }
    },
    "%@ is a direction of this joystick: press another key to run." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ adalah arah joystick ini: tekan tombol lain untuk lari."
          }
        }
      }
    },
    "%@ is a direction of “%@”." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is a direction of “%2$@”."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ adalah salah satu arah “%2$@”."
          }
        }
      }
    },
    "%@ is asking for a fingerprint" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ meminta sidik jari"
          }
        }
      }
    },
    "%@ is asking for a fingerprint. Choose a finger with the fingerprint button in the title bar." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ meminta sidik jari. Pilih jari lewat tombol sidik jari di bilah judul."
          }
        }
      }
    },
    "%@ locks the mouse to aim with the eye, and frees it again." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ mengunci mouse untuk membidik dengan mata, dan melepasnya lagi."
          }
        }
      }
    },
    "%@ ms (max %@)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ ms (max %2$@)"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ms (maks %@)"
          }
        }
      }
    },
    "%@ of %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ of %2$@"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ dari %2$@"
          }
        }
      }
    },
    "%@ runs" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ lari"
          }
        }
      }
