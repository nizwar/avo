    },
    "Android’s Settings is adding a fingerprint: choose the finger to add" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelan Android sedang menambahkan sidik jari: pilih jari yang ingin ditambahkan"
