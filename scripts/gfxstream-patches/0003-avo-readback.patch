+// Avo: a command buffer and fence of the readback's own, and where its copy
+// lands: `outPixels` itself when the device imports it, else a staging buffer
+// that only this readback uses.
+bool VkEmulation::createReadbackAvo(void* outPixels, uint64_t size, AvoReadback* readback) {
+    auto vk = mDvk;
+    if (mAvoCommandPool == VK_NULL_HANDLE) {
+        const VkCommandPoolCreateInfo poolCi = {
+            .sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO,
+            .pNext = nullptr,
+            .flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT,
+            .queueFamilyIndex = mQueueFamilyIndex,
+        };
+        if (vk->vkCreateCommandPool(mDevice, &poolCi, nullptr, &mAvoCommandPool) != VK_SUCCESS) {
+            mAvoCommandPool = VK_NULL_HANDLE;
+            return false;
+        }
+    }
+    const VkCommandBufferAllocateInfo allocateInfo = {
+        .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO,
+        .pNext = nullptr,
+        .commandPool = mAvoCommandPool,
+        .level = VK_COMMAND_BUFFER_LEVEL_PRIMARY,
+        .commandBufferCount = 1,
+    };
+    if (vk->vkAllocateCommandBuffers(mDevice, &allocateInfo, &readback->commandBuffer) != VK_SUCCESS) {
+        readback->commandBuffer = VK_NULL_HANDLE;
+        return false;
+    }
+    const VkFenceCreateInfo fenceCi = {
+        .sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO,
+        .pNext = nullptr,
+        .flags = 0,
+    };
+    if (vk->vkCreateFence(mDevice, &fenceCi, nullptr, &readback->fence) != VK_SUCCESS) {
+        readback->fence = VK_NULL_HANDLE;
+        destroyReadbackAvo(readback);
+        return false;
+    }
+    readback->size = size;
+
+    const VkPhysicalDeviceMemoryProperties& memProps = mDeviceInfo.memProps;
+    const VkDeviceSize alignment = std::max<VkDeviceSize>(
+        mDeviceInfo.externalMemoryHostProps.minImportedHostPointerAlignment,
+        static_cast<VkDeviceSize>(getpagesize()));
+    if (mAvoHostImport && vk->vkGetMemoryHostPointerPropertiesEXT &&
+        reinterpret_cast<uintptr_t>(outPixels) % alignment == 0 && size % alignment == 0) {
+        VkMemoryHostPointerPropertiesEXT hostProps = {
+            .sType = VK_STRUCTURE_TYPE_MEMORY_HOST_POINTER_PROPERTIES_EXT,
+            .pNext = nullptr,
+            .memoryTypeBits = 0,
+        };
+        const VkExternalMemoryBufferCreateInfo externalCi = {
+            .sType = VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_BUFFER_CREATE_INFO,
+            .pNext = nullptr,
+            .handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT,
+        };
+        const VkBufferCreateInfo bufferCi = {
+            .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+            .pNext = &externalCi,
+            .flags = 0,
+            .size = size,
+            .usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+            .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+            .queueFamilyIndexCount = 0,
+            .pQueueFamilyIndices = nullptr,
+        };
+        VkResult result = vk->vkGetMemoryHostPointerPropertiesEXT(
+            mDevice, VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT, outPixels, &hostProps);
+        if (result == VK_SUCCESS) {
+            result = vk->vkCreateBuffer(mDevice, &bufferCi, nullptr, &readback->buffer);
+        }
+        // MoltenVK 1.4.0 takes no external memory info on a buffer
+        // (VK_ERROR_FEATURE_NOT_PRESENT), and a plain buffer binds the
+        // imported memory all the same.
+        if (result == VK_ERROR_FEATURE_NOT_PRESENT) {
+            VkBufferCreateInfo plainCi = bufferCi;
+            plainCi.pNext = nullptr;
+            result = vk->vkCreateBuffer(mDevice, &plainCi, nullptr, &readback->buffer);
+        }
+        if (result == VK_SUCCESS) {
+            VkMemoryRequirements reqs;
+            vk->vkGetBufferMemoryRequirements(mDevice, readback->buffer, &reqs);
+            uint32_t typeIndex = UINT32_MAX;
+            for (uint32_t i = 0; i < memProps.memoryTypeCount; i++) {
+                if ((reqs.memoryTypeBits & hostProps.memoryTypeBits & (1u << i)) &&
+                    (memProps.memoryTypes[i].propertyFlags & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT)) {
+                    typeIndex = i;
+                    break;
+                }
+            }
+            const VkImportMemoryHostPointerInfoEXT importInfo = {
+                .sType = VK_STRUCTURE_TYPE_IMPORT_MEMORY_HOST_POINTER_INFO_EXT,
+                .pNext = nullptr,
+                .handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT,
+                .pHostPointer = outPixels,
+            };
+            const VkMemoryAllocateInfo allocInfo = {
+                .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+                .pNext = &importInfo,
+                .allocationSize = size,
+                .memoryTypeIndex = typeIndex,
+            };
+            if (typeIndex != UINT32_MAX && reqs.size <= size &&
+                vk->vkAllocateMemory(mDevice, &allocInfo, nullptr, &readback->memory) == VK_SUCCESS) {
+                if (vk->vkBindBufferMemory(mDevice, readback->buffer, readback->memory, 0) ==
+                    VK_SUCCESS) {
+                    readback->imported = true;
+                    readback->coherent = memProps.memoryTypes[typeIndex].propertyFlags &
+                                         VK_MEMORY_PROPERTY_HOST_COHERENT_BIT;
+                    return true;
+                }
+                vk->vkFreeMemory(mDevice, readback->memory, nullptr);
+                readback->memory = VK_NULL_HANDLE;
+            }
+            vk->vkDestroyBuffer(mDevice, readback->buffer, nullptr);
+            readback->buffer = VK_NULL_HANDLE;
+        }
+        GFXSTREAM_WARNING("Avo readback: %p (%llu bytes) could not be imported, so it reads "
+                          "through a staging buffer.",
+                          outPixels, static_cast<unsigned long long>(size));
+    }
+
+    StagingBuffer staging;
+    if (!staging.create(vk, mDevice, &memProps, mDebugUtilsHelper, size)) {
+        destroyReadbackAvo(readback);
+        return false;
+    }
+    readback->buffer = staging.mBuffer;
+    readback->memory = staging.mMemory;
+    readback->mapped = staging.mMappedPtr;
+    readback->coherent = staging.mIsHostCoherent;
+    return true;
+}
+
+void VkEmulation::destroyReadbackAvo(AvoReadback* readback) {
+    auto vk = mDvk;
+    if (!vk) return;
+    // A read that gave up waiting may still be on the GPU.
+    if (readback->pending && readback->fence != VK_NULL_HANDLE) {
+        vk->vkWaitForFences(mDevice, 1, &readback->fence, VK_TRUE, 5ULL * 1000ULL * 1000ULL * 1000ULL);
+    }
+    if (readback->buffer != VK_NULL_HANDLE) vk->vkDestroyBuffer(mDevice, readback->buffer, nullptr);
+    // Freeing mapped memory unmaps it.
+    if (readback->memory != VK_NULL_HANDLE) vk->vkFreeMemory(mDevice, readback->memory, nullptr);
+    if (readback->fence != VK_NULL_HANDLE) vk->vkDestroyFence(mDevice, readback->fence, nullptr);
+    if (readback->commandBuffer != VK_NULL_HANDLE && mAvoCommandPool != VK_NULL_HANDLE) {
+        vk->vkFreeCommandBuffers(mDevice, mAvoCommandPool, 1, &readback->commandBuffer);
+    }
+    *readback = AvoReadback{};
+}
+
+void VkEmulation::forgetReadbackMemoryAvo(void* outPixels) {
+    std::lock_guard<std::mutex> avoLock(mAvoMutex);
+    auto it = mAvoReadbacks.find(outPixels);
+    if (it == mAvoReadbacks.end()) return;
+    destroyReadbackAvo(&it->second);
+    mAvoReadbacks.erase(it);
+}
+
+bool VkEmulation::readColorBufferIntoAvo(uint32_t colorBufferHandle, void* outPixels,
+                                         uint64_t outPixelsSize) {
+    auto vk = mDvk;
+    std::lock_guard<std::mutex> avoLock(mAvoMutex);
+
+    auto it = mAvoReadbacks.find(outPixels);
+    if (it != mAvoReadbacks.end() && it->second.size != outPixelsSize) {
+        destroyReadbackAvo(&it->second);
+        mAvoReadbacks.erase(it);
+        it = mAvoReadbacks.end();
+    }
+    if (it == mAvoReadbacks.end()) {
+        AvoReadback created;
+        if (!createReadbackAvo(outPixels, outPixelsSize, &created)) {
+            GFXSTREAM_ERROR("Avo readback: no command buffer or memory for %p.", outPixels);
+            return false;
+        }
+        it = mAvoReadbacks.emplace(outPixels, created).first;
+    }
+    AvoReadback& readback = it->second;
+
+    VkDeviceSize copySize = 0;
+    {
+        std::lock_guard<std::mutex> lock(mMutex);
+        auto colorBufferInfo = gfxstream::base::find(mColorBuffers, colorBufferHandle);
+        if (!colorBufferInfo || !colorBufferInfo->image) {
+            return false;
+        }
+        TransferInfo transferInfo;
+        if (!getFormatTransferInfo(colorBufferInfo->imageCreateInfoShallow.format,
+                                   colorBufferInfo->imageCreateInfoShallow.extent, &transferInfo)) {
+            return false;
+        }
+        // Formats that need unpacking, and a destination too small, go the
+        // ordinary way (which says why when it fails).
+        if (transferInfo.unpackFunction || transferInfo.stagingBufferCopySize > outPixelsSize) {
+            return readColorBufferToBytesLocked(
+                colorBufferHandle, 0, 0, colorBufferInfo->imageCreateInfoShallow.extent.width,
+                colorBufferInfo->imageCreateInfoShallow.extent.height, outPixels, outPixelsSize);
+        }
+        copySize = transferInfo.stagingBufferCopySize;
+
+        // The same commands as readColorBufferToBytesLocked.
+        if (colorBufferInfo->currentLayout == VK_IMAGE_LAYOUT_UNDEFINED) {
+            colorBufferInfo->currentLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+        }
+        const VkCommandBufferBeginInfo beginInfo = {
+            .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
+            .pNext = nullptr,
+            .flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT,
+            .pInheritanceInfo = nullptr,
+        };
+        if (vk->vkBeginCommandBuffer(readback.commandBuffer, &beginInfo) != VK_SUCCESS) {
+            return false;
+        }
+        const VkImageLayout currentLayout = colorBufferInfo->currentLayout;
+        const VkImageLayout transferSrcLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+        const VkImageSubresourceRange range = {
+            .aspectMask = getFormatAspects(colorBufferInfo->imageCreateInfoShallow.format),
+            .baseMipLevel = 0,
+            .levelCount = 1,
+            .baseArrayLayer = 0,
+            .layerCount = 1,
+        };
+        const VkImageMemoryBarrier toTransferSrc = {
+            .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+            .pNext = nullptr,
+            .srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT,
+            .dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT,
+            .oldLayout = currentLayout,
+            .newLayout = transferSrcLayout,
+            .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+            .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+            .image = colorBufferInfo->image,
+            .subresourceRange = range,
+        };
+        vk->vkCmdPipelineBarrier(readback.commandBuffer, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+                                 VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 0, nullptr, 0, nullptr, 1,
+                                 &toTransferSrc);
+        vk->vkCmdCopyImageToBuffer(readback.commandBuffer, colorBufferInfo->image,
+                                   transferSrcLayout, readback.buffer,
+                                   transferInfo.bufferImageCopies.size(),
+                                   transferInfo.bufferImageCopies.data());
+        // The host reads what the GPU wrote.
+        const VkBufferMemoryBarrier toHost = {
+            .sType = VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER,
+            .pNext = nullptr,
+            .srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+            .dstAccessMask = VK_ACCESS_HOST_READ_BIT,
+            .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+            .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+            .buffer = readback.buffer,
+            .offset = 0,
+            .size = VK_WHOLE_SIZE,
+        };
+        vk->vkCmdPipelineBarrier(readback.commandBuffer, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                                 VK_PIPELINE_STAGE_HOST_BIT, 0, 0, nullptr, 1, &toHost, 0, nullptr);
+        if (currentLayout != VK_IMAGE_LAYOUT_UNDEFINED) {
+            const VkImageMemoryBarrier toCurrentLayout = {
+                .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+                .pNext = nullptr,
+                .srcAccessMask = VK_ACCESS_TRANSFER_READ_BIT,
+                .dstAccessMask = VK_ACCESS_NONE_KHR,
+                .oldLayout = transferSrcLayout,
+                .newLayout = currentLayout,
+                .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+                .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+                .image = colorBufferInfo->image,
+                .subresourceRange = range,
+            };
+            vk->vkCmdPipelineBarrier(readback.commandBuffer, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                                     VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 0, nullptr, 0, nullptr,
+                                     1, &toCurrentLayout);
+        } else {
+            colorBufferInfo->currentLayout = transferSrcLayout;
+        }
+        if (vk->vkEndCommandBuffer(readback.commandBuffer) != VK_SUCCESS) {
+            return false;
+        }
+        const VkSubmitInfo submitInfo = {
+            .sType = VK_STRUCTURE_TYPE_SUBMIT_INFO,
+            .pNext = nullptr,
+            .waitSemaphoreCount = 0,
+            .pWaitSemaphores = nullptr,
+            .pWaitDstStageMask = nullptr,
+            .commandBufferCount = 1,
+            .pCommandBuffers = &readback.commandBuffer,
+            .signalSemaphoreCount = 0,
+            .pSignalSemaphores = nullptr,
+        };
+        gfxstream::base::AutoLock queueLock(*mQueueLock);
+        if (vk->vkQueueSubmit(mQueue, 1, &submitInfo, readback.fence) != VK_SUCCESS) {
+            return false;
+        }
+        readback.pending = true;
+    }
+
+    // No renderer lock from here on: the guest's work goes on while the GPU copies.
+    static constexpr uint64_t kWaitNs = 5ULL * 1000ULL * 1000ULL * 1000ULL;
+    VkResult waitRes = vk->vkWaitForFences(mDevice, 1, &readback.fence, VK_TRUE, kWaitNs);
+    if (waitRes == VK_TIMEOUT) {
+        GFXSTREAM_ERROR("Avo readback of ColorBuffer:%d waited 5 s, retrying...", colorBufferHandle);
+        waitRes = vk->vkWaitForFences(mDevice, 1, &readback.fence, VK_TRUE, kWaitNs * 2);
+    }
+    if (waitRes != VK_SUCCESS) {
+        GFXSTREAM_ERROR("Avo readback of ColorBuffer:%d failed: %s", colorBufferHandle,
