+// Avo (scripts/gfxstream-patches/0003): reads resource `handle`'s whole
+// color buffer into `pixels` (tight rows). Unlike transfer_read_iov it may run
+// on a thread of its own while the others go on: it holds the color buffer
+// for the read and no renderer lock while the GPU copies, and page-aligned
+// memory the device can import is written by the GPU directly. 0 on success.
+VG_EXPORT int stream_renderer_avo_read_color_buffer(uint32_t handle, void* pixels, uint64_t size) {
+    GFXSTREAM_TRACE_EVENT(GFXSTREAM_TRACE_STREAM_RENDERER_CATEGORY,
+                          "stream_renderer_avo_read_color_buffer()");
+
+    FrameBuffer* frameBuffer = FrameBuffer::getFB();
+    if (!frameBuffer) return -EINVAL;
+    // Held for the read: a guest that unrefs the resource meanwhile frees
+    // its image only after the copy.
+    gfxstream::host::ColorBufferPtr colorBuffer = frameBuffer->findColorBuffer(handle);
+    if (!colorBuffer) return -ENOENT;
+    return colorBuffer->readToBytesAvo(pixels, size) ? 0 : -EIO;
+}
+
+// Avo: lets go of what reading into `pixels` set up, before that memory goes.
+VG_EXPORT void stream_renderer_avo_forget_readback_memory(void* pixels) {
+    if (FrameBuffer* frameBuffer = FrameBuffer::getFB()) frameBuffer->forgetReadbackMemoryAvo(pixels);
+}
