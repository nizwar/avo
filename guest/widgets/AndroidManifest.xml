<?xml version="1.0" encoding="utf-8"?>
<!-- Avo Widgets: shows Android apps' home screen widgets on the Mac. Each
     widget runs in a WidgetActivity on a display of its own, which a
     floating panel on the Mac shows (the Avo Widgets helper app). The Runtime
     Daemon installs it, lets it bind widgets (`appwidget grantbind`) and
     reads the widgets Android has through WidgetsProvider (HostAgent,
     "Widgets"). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.avo.widgets"
    android:versionCode="1"
    android:versionName="1.0">
    <uses-sdk android:minSdkVersion="34" android:targetSdkVersion="36" />
    <!-- Every app's widgets: as a launcher, it sees all installed apps
         (Android hides apps installed later from it otherwise). -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <application android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:allowBackup="false">
        <!-- One task per widget (FLAG_ACTIVITY_MULTIPLE_TASK from the
             daemon), out of Recents. Size and density changes are the
             display's: the widget lays out again, the activity stays. -->
        <activity android:name=".WidgetActivity" android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:excludeFromRecents="true" android:resizeableActivity="true"
            android:configChanges="density|screenSize|smallestScreenSize|screenLayout|orientation|uiMode|keyboard|keyboardHidden|navigation|fontScale" />
        <!-- The widgets Android has, as JSON, and letting go of a removed
             panel's widget, for Android's shell only (`content read` and
             `content call`, see WidgetsProvider). -->
        <provider android:name=".WidgetsProvider" android:authorities="dev.avo.widgets"
            android:exported="true" />
    </application>
</manifest>
