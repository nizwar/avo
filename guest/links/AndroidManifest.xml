<?xml version="1.0" encoding="utf-8"?>
<!-- Avo Links: Android's default browser on Avo. It shows nothing: the links
     apps open (web pages, e-mail addresses, places) open on the Mac, in its
     default browser, mail app and Maps. The Runtime Daemon installs it and
     makes it the browser once per data disk (HostAgent, "Links"). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.avodroid.links"
    android:versionCode="1"
    android:versionName="1.0">
    <uses-sdk android:minSdkVersion="34" android:targetSdkVersion="36" />
    <application android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:allowBackup="false">
        <!-- Finishes in onCreate: no window, nothing in Recents, nothing left
             in the calling app's task. -->
        <activity android:name=".OpenActivity" android:exported="true" android:label="@string/open_on_mac"
            android:theme="@android:style/Theme.NoDisplay" android:excludeFromRecents="true" android:noHistory="true">
            <!-- Any web address, no host named: what the browser role asks of
                 its holder (a browser handles all web links). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
            <!-- Writing an e-mail: ACTION_SENDTO is how apps ask for one. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mailto" />
            </intent-filter>
            <!-- Places, for the Mac's Maps. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="geo" />
            </intent-filter>
        </activity>
    </application>
</manifest>
